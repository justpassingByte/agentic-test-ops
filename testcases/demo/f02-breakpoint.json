{
  "inspectPort": 9229,
  "timeoutMs": 20000,
  "pauseOnExceptions": "none",
  "breakpoints": [
    { "file": "disputes/disputes.service.ts", "match": "ALLOWED_OPEN_STATUSES.includes(orderStatus)" }
  ],
  "expressions": ["order && order.status", "orderStatus", "ALLOWED_OPEN_STATUSES", "input.category"]
}
